   RowBox[{
    RowBox[{"SetParIndR", "[", 
     RowBox[{"nn_", ",", "pk_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "a", ",", "k", ",", "n", ",", "m", ",", "mm", ",", "qnu", ",", "ppk"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nn", ">", 
          RowBox[{"Total", "[", "pk", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ppk", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{"pk", ",", "EvenQ"}], "]"}], ",", 
              RowBox[{"Select", "[", 
               RowBox[{"pk", ",", "OddQ"}], "]"}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"mm", "=", 
           RowBox[{"Length", "[", "pk", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"qnu", "=", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"Reverse", "[", 
              RowBox[{"Accumulate", "[", 
               RowBox[{"Reverse", "[", "ppk", "]"}], "]"}], "]"}], ",", "1"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Boole", "[", 
               RowBox[{"OddQ", "[", "ppk", "]"}], "]"}], "]"}], 
             "\[LessEqual]", "1"}], ",", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"nn", "-", 
                   RowBox[{"qnu", "[", 
                    RowBox[{"[", "nu", "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
                RowBox[{"{", 
                 RowBox[{"nu", ",", "1", ",", 
                  RowBox[{"mm", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
             RowBox[{"k", "=", 
              RowBox[{"Table", "[", 
               RowBox[{"2", ",", 
                RowBox[{"{", 
                 RowBox[{"nu", ",", "1", ",", 
                  RowBox[{"mm", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
             RowBox[{"n", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
