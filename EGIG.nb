                  RowBox[{"mm", "-", "1"}]}], "}"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
             "Print", "[", 
              "\"\<There is more than one set with an odd number of variables\
\>\"", "]"}], ";", 
             RowBox[{"a", "=", 
              RowBox[{"k", "=", 
               RowBox[{"n", "=", 
                RowBox[{"m", "=", 
                 RowBox[{"{", "}"}]}]}]}]}]}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Sample size too small\>\"", "]"}], ";", 
